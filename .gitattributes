src/lifeweave/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
vendor/lifeweave/** -text whitespace=trailing-space,space-before-tab,cr-at-eol

*.png binary
*.ico binary
*.icns binary
*.pdf binary

# Raw PDF extraction and generated patch retain source whitespace.
docs/syllabus-extracted.txt -whitespace
docs/lifeweave-renderer.diff -whitespace
