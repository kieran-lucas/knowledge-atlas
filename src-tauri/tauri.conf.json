{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge Atlas",
  "version": "1.0.0",
  "identifier": "dev.knowledgeatlas.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --port 1421 --strictPort",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Knowledge Atlas — SPhO",
        "width": 1440,
        "height": 900,
        "minWidth": 480,
        "minHeight": 540,
        "maximized": true,
        "resizable": true,
        "backgroundColor": "#FFFFFF",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
